name = "sfandom-visitor-counter"
main = "worker.js"
compatibility_date = "2026-09-01"

[[durable_objects.bindings]]
name = "COUNTER"
class_name = "VisitorCounter"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["VisitorCounter"]

[vars]
ALLOWED_ORIGINS = "https://sfandom.com,https://www.sfandom.com"
DISPLAY_BASELINE = "0"

# Keep VISITOR_HASH_SECRET out of Git.
# Configure it with the platform's secret manager before deployment.
